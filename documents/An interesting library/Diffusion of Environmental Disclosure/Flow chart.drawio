        <mxCell id="8h6m8IBrfChfro4tER9L-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="客户管理层" vertex="1">
          <mxGeometry height="60" width="120" x="-634" y="262" as="geometry" />
        </mxCell>
        <mxCell id="8h6m8IBrfChfro4tER9L-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="通过内部技术部门、准则研究人员、培训体系、审计软件、工作底稿模板和行业数据库，形成一套相对统一的工作规则" vertex="1">
          <mxGeometry height="110" width="230" x="-474" y="12" as="geometry" />
        </mxCell>
        <mxCell id="8h6m8IBrfChfro4tER9L-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: start;&quot;&gt;项目经理会告知审计团队的成员如何识别风险、判断重要性和执行复核程序，传递内部规则的内容（“audit style”）&lt;/div&gt;" vertex="1">
          <mxGeometry height="78" width="165" x="-142" y="138" as="geometry" />
        </mxCell>
        <mxCell id="8h6m8IBrfChfro4tER9L-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="审计团队的具体沟通" vertex="1">
          <mxGeometry height="35" width="120" x="-432" y="167" as="geometry" />
        </mxCell>
        <mxCell id="8h6m8IBrfChfro4tER9L-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;li class=&quot;my-2 p-0 text-[length:var(--chat-text-size)] leading-[var(--chat-line-height)]&quot;&gt;向客户提供披露清单，使客户按照清单补充环境议题；&lt;/li&gt;&lt;li class=&quot;my-2 p-0 text-[length:var(--chat-text-size)] leading-[var(--chat-line-height)]&quot;&gt;要求客户参考事务所其他客户或同行企业的报告；&lt;/li&gt;&lt;li class=&quot;my-2 p-0 text-[length:var(--chat-text-size)] leading-[var(--chat-line-height)]&quot;&gt;指出客户遗漏的环境话题；&lt;/li&gt;&lt;li class=&quot;my-2 p-0 text-[length:var(--chat-text-size)] leading-[var(--chat-line-height)]&quot;&gt;提供替代表述、邮件措辞或安全表达；&lt;/li&gt;&lt;li class=&quot;my-2 p-0 text-[length:var(--chat-text-size)] leading-[var(--chat-line-height)]&quot;&gt;直接修改客户年报草稿；&lt;/li&gt;&lt;li class=&quot;my-2 p-0 text-[length:var(--chat-text-size)] leading-[var(--chat-line-height)]&quot;&gt;在客户编制能力不足时，参与起草甚至代写部分段落。&lt;/li&gt;" vertex="1">
          <mxGeometry height="98" width="291" x="-499" y="190" as="geometry" />
        </mxCell>
        <mxCell id="8h6m8IBrfChfro4tER9L-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="执行披露" vertex="1">
          <mxGeometry height="39" width="120" x="-634" y="455" as="geometry" />
        </mxCell>
        <mxCell id="8h6m8IBrfChfro4tER9L-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="客户自行编制环境披露的成本较高，&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;事务所可以提供现成的议题、结构和措辞，&lt;/span&gt;客户于是采用事务所提供的模板以节省时间和降低风险" vertex="1">
          <mxGeometry height="84" width="213" x="-563" y="343" as="geometry" />
        </mxCell>
